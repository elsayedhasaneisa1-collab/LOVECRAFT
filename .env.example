# Next.js / Vercel project (Root Directory: repository root). Never commit your .env files.
DATABASE_URL=""
# Set this to your real HTTPS production URL in Vercel. Leave blank for localhost.
NEXT_PUBLIC_APP_URL=""
TELEGRAM_BOT_USERNAME="LoveCraftMakerBot"
# Same strong random secret in the Next.js and Python Vercel projects.
BOT_API_SECRET=""
# A separate secret for stateless QR links; BOT_API_SECRET is the fallback.
QR_SIGNING_SECRET=""
CRON_SECRET=""
CATBOX_USERHASH=""
# Optional: enables remote deletion of abandoned Catbox uploads. Leave empty for anonymous uploads.
# Supabase transaction pooler recommended for the deployed website.
DATABASE_POOLER_MODE=""
# Vercel defaults to 2; local development defaults to 20.
DATABASE_POOL_MAX=""
DATABASE_IDLE_TIMEOUT_MS=""
DATABASE_CONNECTION_TIMEOUT_MS="5000"
DATABASE_STATEMENT_TIMEOUT_MS="15000"

# Optional GitHub template catalogue configuration (not used for media hosting).
GITHUB_TOKEN=""
GITHUB_TEMPLATES_OWNER="elsayedhasaneisa1-collab"
GITHUB_TEMPLATES_REPO="LOVECRAFT"
GITHUB_TEMPLATES_BRANCH="main"

RETENTION_RAW_VISIT_DAYS="7"
RETENTION_VISIT_MARK_DAYS="3"
RETENTION_EXPIRED_SESSION_DAYS="1"
RETENTION_RESOLVED_SECURITY_DAYS="90"
RETENTION_DELETED_SITE_EVENT_DAYS="180"
RETENTION_ORPHAN_ASSET_DAYS="7"

# The following variables go in the Python project's environment and in a trusted
# local environment for scripts/telegram-webhook.mjs, NOT in the web deployment.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
BACKEND_API_URL=""
# Used only by the webhook registration script.
BOT_WEBHOOK_BASE_URL=""
TELEGRAM_WEBHOOK_CONNECTIONS="1"
