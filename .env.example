# LOVECRAFT BOT — Environment Variables Template
# Copy to .env and fill real values. NEVER commit .env to GitHub.

# Database (Supabase PostgreSQL / PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Application Domain
NEXT_PUBLIC_APP_URL="https://domain.com"

# Telegram Bot Configuration (Python aiogram & Webhook)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME="LoveCraftMakerBot"
TELEGRAM_WEBHOOK_SECRET=""

# Internal Bot <-> Backend Communication Secret
BOT_API_SECRET=""

# Cron Job Protection Secret (required by /api/cron/evaluate-sites and /api/cron/retention)
CRON_SECRET=""

# PostgreSQL connection pool tuning (resource protection)
DATABASE_POOL_MAX="20"
DATABASE_IDLE_TIMEOUT_MS="30000"
DATABASE_CONNECTION_TIMEOUT_MS="5000"
DATABASE_STATEMENT_TIMEOUT_MS="15000"

# Data retention windows in days (housekeeping keeps the database small)
RETENTION_RAW_VISIT_DAYS="7"
RETENTION_VISIT_MARK_DAYS="3"
RETENTION_EXPIRED_SESSION_DAYS="1"
RETENTION_RESOLVED_SECURITY_DAYS="90"
RETENTION_DELETED_SITE_EVENT_DAYS="180"
RETENTION_ORPHAN_ASSET_DAYS="7"

# GitHub Template Repository Integration (optional for private repos)
GITHUB_TOKEN=""
GITHUB_TEMPLATES_OWNER="elsayedhasaneisa1-collab"
GITHUB_TEMPLATES_REPO="LOVECRAFT"
GITHUB_TEMPLATES_BRANCH="main"

# Catbox Image Hosting (optional userhash; leave empty for anonymous upload)
CATBOX_USERHASH=""

# QR card cache directory (must be writable; defaults to the system temp folder)
QR_CACHE_DIR=""

# One-Time Secure Owner Provisioning Token (disable/remove after creating owner)
ADMIN_SETUP_TOKEN=""
